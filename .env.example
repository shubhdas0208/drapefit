# Names DrapeFit reads. Keep real values in Windows user env vars (setx) locally and in the
# Render dashboard in production. Never commit a filled-in copy.
TELEGRAM_BOT_TOKEN=        # @BotFather -> /newbot
TELEGRAM_WEBHOOK_SECRET=   # any long random string; Render generates one (copy it for set_webhook.py)
TASKS_SECRET=              # random; cron-job.org sends it as X-Tasks-Secret to /tasks/followups
SARVAM_API_KEY=            # already set as a Windows user env var
SARVAM_MODEL=sarvam-105b-conversations
SHOPIFY_CLIENT_ID=         # Dev Dashboard -> Agents -> Agent identities
SHOPIFY_CLIENT_SECRET=
DATABASE_URL=              # Neon connection string (postgresql://...?sslmode=require). Local: sqlite:///./drapefit-local.db
PUBLIC_BASE_URL=           # https://<service>.onrender.com
AGENT_PROFILE_URL=         # optional; defaults to Shopify's example profile
